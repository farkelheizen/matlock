[hooks]
configured = ["matlock2.hooks:project_id_from_path"]

[ingest]
vault_path = "./my-markdown-vault"
database_path = "./.matlock2/index.sqlite3"
busy_timeout_ms = 5000
reconcile_interval_seconds = 300

[chunking]
target_tokens = 400
overlap_tokens = 50

[embedding]
model = "BAAI/bge-small-en-v1.5"
dimensions = 384
max_input_tokens = 512

# Optional: settings for `matlock2-scanner` (see docs/secret-scanner.md).
# [secret_scanner]
# enabled_layers = ["heuristic", "llm"]
# interval_seconds = 60
# max_chunk_chars = 4000
# max_document_chars = 50000
#
# [secret_scanner.llm]
# model_id = "meta-llama/Llama-3.2-1B-Instruct"
# prompt_file = "./prompt.txt"
#
# [secret_scanner.hooks]
# pre_scan = "my_hooks:skip_public"
